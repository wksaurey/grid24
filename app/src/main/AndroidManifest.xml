<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- VIBRATE only (added 2026-07-19: user-controlled haptic intensity needs
         VibrationEffect amplitude control; performHapticFeedback has no
         intensity API). INTERNET must never be added — a keyboard that provably
         cannot exfiltrate is the point (see docs/research/fdroid-distribution.md). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:label="@string/app_name"
        android:allowBackup="false">
        <!-- Settings lab: reachable from the system keyboard-settings gear
             (method.xml settingsActivity) and the launcher. -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".Grid24Ime"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <!-- name is literally "android.view.im", not ".ime" -->
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
