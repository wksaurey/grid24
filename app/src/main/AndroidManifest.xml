<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No permissions. Not even VIBRATE: haptics go through performHapticFeedback.
         INTERNET must never be added — a keyboard that provably cannot exfiltrate
         is the point (see docs/research/fdroid-distribution.md). -->
    <application android:label="@string/app_name">
        <service
            android:name=".Grid24Ime"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <!-- name is literally "android.view.im", not ".ime" -->
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
